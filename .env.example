# Optional — enables the opt-in AI features (document reading, interview feedback).
# Without it, the app runs fully client-side with manual entry.
ANTHROPIC_API_KEY=

# Optional model overrides (default: claude-opus-5)
EXTRACTION_MODEL=
INTERVIEW_MODEL=
ASK_MODEL=

# Optional — enables accounts + cross-device sync (see db/schema.sql).
# Without these, the app stays fully on-device and no account UI is shown.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
